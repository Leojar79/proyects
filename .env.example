# Azure AD App Registration
# Crear en: https://portal.azure.com > Azure Active Directory > App registrations
VITE_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Ruta de la carpeta en OneDrive de la empresa donde se depositan los Excel
# Ejemplo: "Siigo/Reportes/Agente" o "Analytics/AgenteSiigo"
VITE_ONEDRIVE_FOLDER=Siigo/Analytics

# Intervalo de refresco automático en milisegundos (por defecto 5 minutos)
VITE_REFRESH_INTERVAL_MS=300000
