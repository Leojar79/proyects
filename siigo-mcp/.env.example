# Copia este archivo como .env DENTRO de siigo-mcp/ y reemplaza los valores de ejemplo.
# siigo-mcp/.gitignore ignora ese .env (solo dentro de siigo-mcp/): NUNCA lo subas a git.
# El servidor no lee .env por sí mismo; cárgalo con:
#   uv run --directory /ruta/absoluta/siigo-mcp --env-file /ruta/absoluta/siigo-mcp/.env siigo-mcp

# Obligatorias
SIIGO_USERNAME=usuario-api@tu-empresa.com
SIIGO_ACCESS_KEY=reemplaza-con-tu-access-key
SIIGO_PARTNER_ID=MiEmpresaMCP

# Opcionales (valores por defecto entre paréntesis)
# Usa 10 con la empresa de pruebas (sandbox); 100 en producción (100)
SIIGO_RATE_LIMIT_PER_MINUTE=10
# Debe ser https:// (http:// solo se acepta para localhost)
# SIIGO_BASE_URL=https://api.siigo.com
# SIIGO_TIMEOUT_SECONDS=120
# SIIGO_DOWNLOAD_DIR=~/Downloads/siigo
# DEBUG, INFO, WARNING, ERROR o CRITICAL
# SIIGO_LOG_LEVEL=INFO

# Herramientas de escritura (crear clientes/facturas, enviar correo, anular, eliminar)
# true, 1 o yes las habilita; false, 0, no u off las deja desactivadas (otro valor es un error)
SIIGO_ENABLE_WRITE=false
